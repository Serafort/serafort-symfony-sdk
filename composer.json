{
  "name": "serafort/symfony-bundle",
  "description": "Enterprise IAM, Security Authenticator, Voter, and Wildcard RBAC for Symfony 6.4 and 7+.",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Serafort",
      "email": "engineering@serafort.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/http-kernel": "^6.4 || ^7.0",
    "symfony/dependency-injection": "^6.4 || ^7.0",
    "symfony/config": "^6.4 || ^7.0",
    "symfony/security-http": "^6.4 || ^7.0",
    "symfony/security-core": "^6.4 || ^7.0",
    "guzzlehttp/guzzle": "^7.8",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "Serafort\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Serafort\\Symfony\\Tests\\": "tests/"
    }
  }
}
